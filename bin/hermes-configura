#!/bin/sh
# Compila i valori per-installazione che bin/hermes-bootstrap lascia a
# DA_COMPILARE, e installa le due chiavi: quella dell'amministratore nella
# sua authorized_keys, quella del servizio dove la legge sshd.
#
#     sudo bin/hermes-configura            # chiede ciò che manca
#     sudo bin/hermes-configura --prova    # valida e mostra, senza scrivere
#     sudo bin/hermes-configura --utente UTENTE \
#          --chiave-admin admin.pub --chiave servizio.pub \
#          --reti 192.0.2.0/24 --alias lab-web=192.0.2.20 \
#          --postazione 192.0.2.1
#
# Va eseguito DOPO il bootstrap: riempie i file che quello ha generato.
#
# Gli indirizzi degli esempi sono di 192.0.2.0/24, la rete che la RFC 5737
# riserva alla documentazione. Non è pignoleria: un esempio copiato per
# sbaglio in un perimetro non deve autorizzare niente di reale, e un esempio
# preso da una rete di laboratorio vera lo farebbe.
#
# Perché esiste
# -------------
#
# I valori per-installazione erano sei, sparsi in cinque file, da mettere a
# mano seguendo quattro sezioni del documento. Durante il test di
# accettazione quella trafila ha prodotto, in una sera: una chiave privata
# sovrascritta, un YAML digitato a mano sulla console della VM, un
# AllowUsers dimenticato che ha chiuso fuori l'amministratore, e un
# perimetro con una virgoletta mancante alla riga 31. Nessuno di quegli
# errori era difficile da evitare. Erano tutti facili da fare.
#
# Cosa NON fa, ed è la parte che conta
# ------------------------------------
#
# NON RICARICA sshd. Scrivere un file è reversibile, ricaricare no: una
# riga sbagliata in AllowUsers e una macchina remota non si raggiunge più,
# con le password già disattivate dal drop-in. Quel comando resta
# all'operatore, DOPO aver verificato la chiave da una finestra nuova. È
# l'errore che il test di accettazione ha prodotto due volte in un giorno,
# entrambe seguendo la procedura alla lettera.
#
# NON TOGLIE le regole aperte di ufw. Aggiunge quella ristretta alla
# postazione e dice quali togliere: cancellare l'accesso SSH è nella stessa
# classe del ricarico - se l'indirizzo è sbagliato ci si chiude fuori, e il
# sintomo arriva alla prossima connessione, non adesso.
#
# NON APPLICA la configurazione di rete. Scrive il file e si ferma:
# `netplan try` cambia indirizzo, fa cadere la sessione SSH, e senza
# conferma annulla tutto. Va eseguito dalla console, ed è una riga da
# digitare invece di quindici di YAML indentato.
#
# NON INDOVINA. Risposta vuota o non valida: richiede. Nessun default
# plausibile, mai - un segnaposto plausibile passa i validatori e consegna
# una configurazione sbagliata, che è il guasto peggiore dei due. Un nome
# utente vero in AllowUsers e la rete di un laboratorio vero nel modello del
# perimetro erano entrambi valori plausibili, e sono entrambi arrivati su
# macchine a cui non appartenevano.
#
# NON SOVRASCRIVE un valore già compilato senza dirlo e chiedere.
#
# Come valida
# -----------
#
# Con i validatori veri, dove esistono. Il perimetro viene scritto in un
# file temporaneo e dato al caricatore del progetto: si installa solo se
# quello lo accetta. Riscrivere le regole delle reti in shell vorrebbe dire
# avere due verità che col tempo divergono, e la verità sbagliata sarebbe
# quella che l'operatore vede per prima.
#
# L'utente deve ESISTERE su questa macchina: un nome con un refuso passa
# `sshd -t`, passa il preflight, e chiude fuori.
#
# Le chiavi passano per `ssh-keygen -l`, che è il validatore vero. Prima lo
# script controllava solo che stessero su una riga e iniziassero con
# `ssh-ed25519`: una chiave spezzata dall'incollata - di cui il terminale
# consegna solo la prima riga - o con un carattere in meno passava entrambi i
# controlli, finiva in authorized_keys, e si manifestava come un `Permission
# denied (publickey)` che non nomina la causa. Verificato: `ssh-keygen -l`
# rifiuta entrambe.
#
# E le due chiavi non devono essere scambiate. Hanno la stessa forma e la
# stessa lunghezza, quindi l'unico appiglio è il commento: quello che la
# procedura fa generare. Una chiave che si dichiara del servizio non viene
# accettata come quella dell'amministratore, e viceversa, e due chiavi
# identiche vengono rifiutate.

set -eu

# --- Costanti ------------------------------------------------------------- #
#
# Gli stessi percorsi del bootstrap. Un test della suite li legge dai due
# script e li confronta: dove la copia è inevitabile, la coincidenza va
# verificata, non sperata.

UTENTE_SERVIZIO=hermes
UTENTE_TOOL=hermes-tool
UTENTE_SPEDIZIONE=hermes-ship

# I percorsi si possono sovrascrivere da ambiente, e serve a una cosa sola:
# permettere alla suite di esercitare questo script su una directory
# temporanea. Non è una via per redirigere un'esecuzione vera - `sudo` di
# default azzera l'ambiente (env_reset), quindi queste variabili non
# arrivano nemmeno. Uno script di dispiegamento che nessun test può lanciare
# è uno script che nessuno ha mai visto sbagliare, e quel debito il
# bootstrap ce l'ha già.
DIR_CONFIG=${HERMES_DIR_CONFIG:-/etc/hermes}
SCOPE=$DIR_CONFIG/scope.toml
DIR_SSHD=${HERMES_DIR_SSHD:-/etc/ssh/sshd_config.d}
DROPIN=$DIR_SSHD/10-hermes.conf
DROPIN_UTENTI=$DIR_SSHD/09-hermes-allowusers.conf
DIR_CHIAVI=${HERMES_DIR_CHIAVI:-/etc/ssh/authorized_keys.d}
CHIAVE_SERVIZIO=$DIR_CHIAVI/$UTENTE_SERVIZIO
NETPLAN=${HERMES_NETPLAN:-/etc/netplan/99-hermes-static.yaml}
# La home dell'amministratore si legge da getent. L'override serve solo ai
# test, per esercitare la scrittura della sua authorized_keys - compreso il
# rifiuto di un ~/.ssh che è un link simbolico - senza toccare la home vera
# di chi lancia la suite.
HOME_AMMINISTRATORE_FORZATA=${HERMES_HOME_AMMINISTRATORE:-}

NON_COMPILATO=DA_COMPILARE

# I commenti che la procedura fa dare alle due chiavi. Sono l'unico modo di
# distinguerle, perché hanno la stessa forma e la stessa lunghezza.
COMMENTO_SERVIZIO=hermes-core@
COMMENTO_ADMIN=admin@

PROVA=no
FORZA=no
UTENTE=""
CHIAVE=""
CHIAVE_ADMIN=""
RETI=""
ALIAS=""
POSTAZIONE=""
INTERFACCIA=""
INDIRIZZO=""
GATEWAY=""

RESTA=""
PROMEMORIA=""
CAMBIATO=no

# --- Uscita --------------------------------------------------------------- #

fatto()     { CAMBIATO=si; printf '[  fatto  ] %s\n' "$1"; }
invariato() { printf '[invariato] %s\n' "$1"; }
saltato()   { printf '[ saltato ] %s\n' "$1"; }
mostra()    { printf '[  prova  ] %s\n' "$1"; }

fermati() {
    printf '\n[ FERMO ] %s\n' "$1" >&2
    if [ $# -gt 1 ]; then
        printf '          %s\n' "$2" >&2
    fi
    exit 1
}

resta()      { RESTA="$RESTA  · $1
"; }
promemoria() { PROMEMORIA="$PROMEMORIA  · $1
"; }

aiuto() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    cat <<'EOF'
Opzioni:
  --prova             non scrive niente: valida ogni risposta e stampa i file
                      che scriverebbe. Non richiede root, ed è così che la
                      suite esercita questo script - per te è un'anteprima
  --forza             sostituisce anche i valori già compilati
  --utente NOME       utente amministrativo ammesso da SSH (deve esistere)
  --chiave-admin F|T  chiave PUBBLICA dell'amministratore: va nella sua
                      ~/.ssh/authorized_keys
  --chiave F|T        chiave PUBBLICA del servizio
  --reti A,B          reti del perimetro, in forma canonica
  --alias n=IP,...    alias dei bersagli, dentro le reti
  --postazione IP     indirizzo da cui Hermes si connette (regola ufw)
  --interfaccia NOME  interfaccia per l'indirizzo fisso
  --indirizzo CIDR    indirizzo fisso, per esempio 192.0.2.10/24
  --gateway IP        solo se questa interfaccia deve portare la rotta di
                      default: con una seconda scheda che la porta già,
                      ometterlo - due rotte di default spengono l'uscita
  --aiuto             questo testo
EOF
}

while [ $# -gt 0 ]; do
    case $1 in
        --prova)       PROVA=si ;;
        --forza)       FORZA=si ;;
        --utente)      shift; UTENTE=${1:-} ;;
        --chiave)      shift; CHIAVE=${1:-} ;;
        --chiave-admin) shift; CHIAVE_ADMIN=${1:-} ;;
        --reti)        shift; RETI=${1:-} ;;
        --alias)       shift; ALIAS=${1:-} ;;
        --postazione)  shift; POSTAZIONE=${1:-} ;;
        --interfaccia) shift; INTERFACCIA=${1:-} ;;
        --indirizzo)   shift; INDIRIZZO=${1:-} ;;
        --gateway)     shift; GATEWAY=${1:-} ;;
        --aiuto|-h)    aiuto; exit 0 ;;
        *)             fermati "opzione non riconosciuta: $1" "bin/hermes-configura --aiuto" ;;
    esac
    shift
done

# In prova non serve root: è il modo di esercitare questo script senza che
# possa fare danni, e la suite lo usa così. Un test che deve girare da root
# per dire qualcosa è un test che da root installa davvero.
if [ "$PROVA" = no ] && [ "$(id -u)" -ne 0 ]; then
    fermati "serve root" "sudo bin/hermes-configura"
fi

REPO=$(cd "$(dirname "$0")/.." && pwd)

# Serve un Python solo per VALIDARE: le reti con `ipaddress`, il perimetro
# con il caricatore del progetto. Si preferisce quello del virtualenv perché
# è l'interprete con cui girerà il server, ma per validare basta qualunque
# python3: la libreria è standard e il modulo si importa dalla radice del
# repo. L'ordine rispetto al bootstrap non lo impone questa riga - lo
# impongono i file che questo script riempie, che è il bootstrap a generare.
if [ -x "$REPO/.venv/bin/python" ]; then
    PY=$REPO/.venv/bin/python
elif PY=$(command -v python3); then
    :
else
    fermati "serve python3" "su Debian/Ubuntu: apt install python3"
fi

# `ssh-keygen` è il validatore delle chiavi. Su Debian/Ubuntu arriva con
# openssh-client, che openssh-server si porta dietro: se manca, manca anche
# il server, e il problema è a monte di questo script.
if ! command -v ssh-keygen >/dev/null 2>&1; then
    fermati "serve ssh-keygen per validare le chiavi" "su Debian/Ubuntu: apt install openssh-client"
fi

interattivo() { [ -t 0 ]; }

# Ogni domanda dice da dove si ricava la risposta.
#
# È un suggerimento, non un oracolo, e la parola «prova» è scelta: il comando
# mostra dove guardare, la scelta resta di chi installa. `$SUDO_USER` è vuoto
# se si è entrati come root; l'ARP conosce solo le macchine che hanno parlato
# di recente; fra due reti attaccate, quale sia quella giusta dipende da cosa
# serve, non da `ip route`.
#
# Un comando presentato come risposta definitiva diventa un valore incollato
# senza guardarlo. Il nome utente in AllowUsers e la rete nel modello del
# perimetro sono arrivati dove sono arrivati esattamente così: erano
# plausibili, e nessuno li ha riletti.
suggerimento() {
    printf '  prova:  %s\n' "$1"
    if [ $# -gt 1 ]; then
        printf '          %s\n' "$2"
    fi
}

# Chiede un valore finché non passa il suo validatore.
#
# Il validatore stampa il valore CANONICO e esce 0, oppure stampa il motivo
# e esce 1. Canonico e non "quello battuto": `192.0.2.0/255.255.255.0`
# diventa `192.0.2.0/24`, e il file contiene la forma che il caricatore
# confronterà.
chiedi() {
    nome=$1; domanda=$2; validatore=$3; opzione=$4
    eval "valore=\${$nome}"
    while : ; do
        if [ -n "$valore" ]; then
            if esito=$("$validatore" "$valore" 2>&1); then
                eval "$nome=\$esito"
                return 0
            fi
            printf '  rifiutato: %s\n' "$esito" >&2
            interattivo || fermati "valore non valido per $opzione" "$esito"
            valore=""
        fi
        interattivo || fermati "manca $opzione" "in modo non interattivo ogni valore va passato come opzione"
        printf '%s ' "$domanda"
        read -r valore || fermati "ingresso chiuso senza risposta"
    done
}

# Un valore già compilato non si salta in silenzio: si mostra e si chiede.
#
# Saltarlo obbligava a ricordarsi `--forza`, e chi rilancia questo script lo
# rilancia proprio perché vuole cambiare qualcosa: la risposta «non tocco
# niente, riesegui con un'opzione che non ti ho detto» è un vicolo. Si
# scorrono tutte le voci dall'inizio, ogni volta, e dove c'è già un valore
# lo si fa vedere prima di chiedere.
#
# Senza terminale non c'è nessuno a cui chiedere: lì vale `--forza`, perché
# un automatismo che sovrascrive una decisione dell'operatore solo perché è
# stato rilanciato è la regola di idempotenza del bootstrap al contrario.
da_compilare() {
    etichetta=$1; attuale=$2
    [ -n "$attuale" ] || return 0
    [ "$FORZA" = no ] || return 0
    if ! interattivo; then
        invariato "$etichetta: già compilato ($attuale)"
        return 1
    fi
    printf '\n%s è già compilato:\n  %s\n' "$etichetta" "$attuale"
    printf '  sostituire? [s/N] '
    read -r risposta || risposta=n
    case $risposta in
        s|S|si|Si|SI|y|Y) return 0 ;;
        *) invariato "$etichetta: lasciato come era"; return 1 ;;
    esac
}

# --- Validatori ----------------------------------------------------------- #

valida_utente() {
    # Prima il nome, poi l'esistenza: il nome è una proprietà della stringa e
    # la risposta è la stessa su ogni macchina, mentre l'esistenza dipende da
    # dove giriamo. Nell'ordine inverso, su una macchina dove gli utenti di
    # servizio non ci sono ancora, a chi scrive `hermes` si risponderebbe
    # «non esiste» invece di «è il servizio, qui va il tuo utente» - vero, e
    # inutile.
    case $1 in
        "$UTENTE_SERVIZIO"|"$UTENTE_TOOL"|"$UTENTE_SPEDIZIONE")
            printf "'%s' è un utente di servizio: qui va il TUO utente amministrativo" "$1"
            return 1 ;;
    esac
    if ! id -u "$1" >/dev/null 2>&1; then
        printf "l'utente '%s' non esiste su questa macchina: un nome con un refuso passa 'sshd -t' e chiude fuori" "$1"
        return 1
    fi
    printf '%s' "$1"
}

valida_chiave() {
    testo=$1
    if [ -f "$1" ]; then
        testo=$(cat "$1")
    fi
    righe=$(printf '%s\n' "$testo" | grep -c '[^[:space:]]' || true)
    if [ "$righe" -ne 1 ]; then
        printf 'sono %s righe non vuote: una chiave pubblica sta su una riga sola. Hai incollato la chiave PRIVATA?' "$righe"
        return 1
    fi
    testo=$(printf '%s' "$testo" | tr -d '\n\r')
    case $testo in
        "ssh-ed25519 "*|"ssh-rsa "*|"ecdsa-sha2-"*|"sk-ssh-ed25519@"*|"sk-ecdsa-sha2-"*) ;;
        *) printf "non ha la forma di una chiave pubblica OpenSSH (atteso 'ssh-ed25519 AAAA... commento')"
           return 1 ;;
    esac

    # Il giudice finale. I due controlli sopra danno messaggi chiari nei casi
    # comuni, ma una chiave spezzata dall'incollata li passa entrambi: è una
    # riga sola - il terminale consegna solo la prima - e inizia nel modo
    # giusto. `ssh-keygen -l` decodifica il blob e la rifiuta.
    prova_chiave=$(mktemp)
    printf '%s\n' "$testo" > "$prova_chiave"
    if ! ssh-keygen -l -f "$prova_chiave" >/dev/null 2>&1; then
        rm -f "$prova_chiave"
        printf "ssh-keygen non la riconosce come chiave: probabilmente è spezzata o incompleta. Se l'hai incollata, riprova copiando la riga intera, oppure indica il percorso del file .pub"
        return 1
    fi
    rm -f "$prova_chiave"
    printf '%s' "$testo"
}

blob_di()     { printf '%s' "$1" | cut -d' ' -f2; }
commento_di() { printf '%s' "$1" | cut -d' ' -f3-; }

# Le due chiavi hanno la stessa forma e la stessa lunghezza: l'unico modo di
# distinguerle è il commento che la procedura fa dare a ciascuna. Si rifiuta
# solo il segnale positivo dello scambio - una chiave che si DICHIARA
# dell'altro - così un commento personalizzato non blocca nessuno.
valida_chiave_admin() {
    k=$(valida_chiave "$1") || { printf '%s' "$k"; return 1; }
    case $(commento_di "$k") in
        "$COMMENTO_SERVIZIO"*)
            printf "il commento dice '%s': è la chiave del SERVIZIO. Qui va la TUA, quella con commento '%s…'" \
                   "$(commento_di "$k")" "$COMMENTO_ADMIN"
            return 1 ;;
    esac
    if [ -n "$CHIAVE" ] && [ "$(blob_di "$k")" = "$(blob_di "$CHIAVE")" ]; then
        printf "è la stessa chiave data come chiave del servizio: le due devono essere diverse"
        return 1
    fi
    printf '%s' "$k"
}

valida_chiave_servizio() {
    k=$(valida_chiave "$1") || { printf '%s' "$k"; return 1; }
    case $(commento_di "$k") in
        "$COMMENTO_ADMIN"*)
            printf "il commento dice '%s': è la TUA chiave. Qui va quella del SERVIZIO, con commento '%s…'" \
                   "$(commento_di "$k")" "$COMMENTO_SERVIZIO"
            return 1 ;;
    esac
    if [ -n "$CHIAVE_ADMIN" ] && [ "$(blob_di "$k")" = "$(blob_di "$CHIAVE_ADMIN")" ]; then
        printf "è la stessa chiave data come tua: le due devono essere diverse"
        return 1
    fi
    printf '%s' "$k"
}

impronta() {
    f=$(mktemp)
    printf '%s\n' "$1" > "$f"
    ssh-keygen -l -f "$f" 2>/dev/null | cut -d' ' -f2
    rm -f "$f"
}

valida_ip() {
    "$PY" - "$1" <<'PYEOF'
import ipaddress, sys
try:
    print(ipaddress.ip_address(sys.argv[1].strip()))
except ValueError as err:
    print(err); sys.exit(1)
PYEOF
}

valida_interfaccia() {
    # L'interfaccia deve esistere: un nome con un refuso produce un file
    # netplan sintatticamente valido che non configura niente, e lo scopri
    # applicandolo - cioè quando l'indirizzo vecchio è già sparito.
    if [ -d /sys/class/net ] && [ ! -e "/sys/class/net/$1" ]; then
        disponibili=$(ls /sys/class/net 2>/dev/null | tr '\n' ' ')
        printf "l'interfaccia '%s' non esiste. Su questa macchina: %s" "$1" "$disponibili"
        return 1
    fi
    printf '%s' "$1"
}

valida_cidr() {
    "$PY" - "$1" <<'PYEOF'
import ipaddress, sys
grezzo = sys.argv[1].strip()
if "/" not in grezzo:
    print("manca la lunghezza del prefisso: per esempio 192.0.2.10/24")
    sys.exit(1)
try:
    print(ipaddress.ip_interface(grezzo))
except ValueError as err:
    print(err); sys.exit(1)
PYEOF
}

valida_reti() {
    "$PY" - "$1" <<'PYEOF'
import ipaddress, sys
grezze = [x.strip() for x in sys.argv[1].split(",") if x.strip()]
if not grezze:
    print("nessuna rete indicata"); sys.exit(1)
fuori = []
for g in grezze:
    try:
        # strict: 192.0.2.1/24 non è una rete, è un host dentro una rete.
        # Accettarlo e "correggerlo" in silenzio darebbe un perimetro che
        # non è quello che l'operatore crede di aver scritto.
        fuori.append(str(ipaddress.ip_network(g, strict=True)))
    except ValueError as err:
        print(f"'{g}': {err}"); sys.exit(1)
print(",".join(fuori))
PYEOF
}

valida_alias() {
    "$PY" - "$1" "$RETI" <<'PYEOF'
import ipaddress, sys
grezzi = [x.strip() for x in sys.argv[1].split(",") if x.strip()]
reti = [ipaddress.ip_network(r) for r in sys.argv[2].split(",") if r.strip()]
fuori = []
for g in grezzi:
    if "=" not in g:
        print(f"'{g}': manca l'uguale (atteso nome=indirizzo)"); sys.exit(1)
    nome, _, grezzo = g.partition("=")
    nome, grezzo = nome.strip(), grezzo.strip()
    if not nome:
        print(f"'{g}': nome vuoto"); sys.exit(1)
    try:
        indirizzo = ipaddress.ip_address(grezzo)
    except ValueError as err:
        print(f"alias '{nome}': {err}"); sys.exit(1)
    # Un alias fuori dalle reti non è un errore di battitura innocuo: è un
    # bersaglio che il gate rifiuterebbe comunque, dichiarato come se fosse
    # ammesso.
    if not any(indirizzo in r for r in reti):
        print(f"alias '{nome}' ({indirizzo}) non è in nessuna delle reti dichiarate")
        sys.exit(1)
    fuori.append(f"{nome}={indirizzo}")
print(",".join(fuori))
PYEOF
}

# --- Scrittura ------------------------------------------------------------ #
#
# Ogni scrittura passa da qui, così `--prova` è una proprietà dello script e
# non di chi si ricorda di controllare la variabile.

installa() {
    sorgente=$1; destinazione=$2; modo=$3; etichetta=$4
    proprietario=${5:-root}; gruppo=${6:-root}
    if [ "$PROVA" = si ]; then
        mostra "$etichetta"
        printf '           ---8<--- %s (modo %s, di %s:%s)\n' \
               "$destinazione" "$modo" "$proprietario" "$gruppo"
        sed 's/^/           /' "$sorgente"
        printf '           --->8---\n'
        rm -f "$sorgente"
        return 0
    fi
    install -m "$modo" -o "$proprietario" -g "$gruppo" "$sorgente" "$destinazione"
    rm -f "$sorgente"
    fatto "$etichetta"
}

# --- 1. Chi può entrare --------------------------------------------------- #
#
# Primo, e non per caso: è il valore che chiude fuori l'amministratore se
# resta a DA_COMPILARE quando qualcuno ricarica sshd. Tutto il resto si
# ripara in SSH, questo no.

if [ ! -f "$DROPIN_UTENTI" ]; then
    fermati "manca $DROPIN_UTENTI" "lo genera il bootstrap: sudo bin/hermes-bootstrap"
fi

ATTUALE=$(sed -n 's/^AllowUsers //p' "$DROPIN_UTENTI" | head -1)
case $ATTUALE in *"$NON_COMPILATO"*) ATTUALE="" ;; esac

if da_compilare "Chi può entrare via SSH" "$ATTUALE"; then
    if [ -z "$UTENTE" ] && interattivo; then
        printf '\nCHI PUÒ ENTRARE IN QUESTA MACCHINA VIA SSH.\n'
        printf 'Il tuo utente amministrativo: quello con cui ti colleghi adesso.\n'
        printf "Quando ricaricherai sshd le password verranno disattivate, e chi\n"
        printf 'non è in questo elenco resta fuori — compreso te, se sbagli il nome.\n'
        suggerimento 'echo $SUDO_USER' \
                     "chi ha lanciato questo script con sudo (vuoto se sei entrato come root)"
    fi
    chiedi UTENTE "  utente amministrativo:" valida_utente --utente
    tmp=$(mktemp)
    sed "s/^AllowUsers .*/AllowUsers $UTENTE $UTENTE_SERVIZIO/" \
        "$DROPIN_UTENTI" > "$tmp"
    installa "$tmp" "$DROPIN_UTENTI" 644 \
             "accesso SSH: AllowUsers $UTENTE $UTENTE_SERVIZIO"
    AMMINISTRATORE=$UTENTE
else
    # L'amministratore è quello che sta DAVVERO nel file, non quello passato
    # con --utente. Se il file non è stato toccato, prendere --utente vorrebbe
    # dire installare la chiave a un utente che sshd non lascia entrare: la
    # chiave c'è, AllowUsers nomina un altro, e al ricarico si resta fuori.
    # Trovato dalla suite, non immaginato.
    AMMINISTRATORE=$(printf '%s' "$ATTUALE" | cut -d' ' -f1)
    if [ -n "$UTENTE" ] && [ "$UTENTE" != "$AMMINISTRATORE" ]; then
        printf '  --utente %s ignorato: il file dice %s (per sostituirlo: --forza)\n' \
               "$UTENTE" "$AMMINISTRATORE"
    fi
fi

# --- 2. La chiave dell'amministratore ------------------------------------- #
#
# Va nella authorized_keys del suo utente, e va messa adesso: il ricarico di
# sshd disattiva le password, e senza questa chiave l'amministratore resta
# fuori.
#
# Si scrive da root nella home di un altro utente, quindi con due cautele.
# Si rifiuta un ~/.ssh, o una authorized_keys, che sia un link simbolico:
# seguirlo da root vorrebbe dire scrivere dove punta il link, cioè dove ha
# deciso chi l'ha creato. E il file risultante è sempre del suo utente, con i
# permessi che StrictModes di sshd pretende - altrimenti sshd lo ignora in
# silenzio, e il sintomo è lo stesso `Permission denied` di una chiave rotta.
#
# Le chiavi già presenti non si toccano: si aggiunge, non si sostituisce.

if [ -z "$AMMINISTRATORE" ]; then
    saltato "chiave dell'amministratore: nessun utente amministrativo compilato"
else
    HOME_ADM=$HOME_AMMINISTRATORE_FORZATA
    if [ -z "$HOME_ADM" ]; then
        HOME_ADM=$(getent passwd "$AMMINISTRATORE" | cut -d: -f6)
    fi
    # Un AllowUsers già compilato può nominare un utente che qui non esiste -
    # compilato a mano, prima che questo script lo validasse. Meglio dirlo
    # adesso che scoprirlo al ricarico di sshd.
    GRUPPO_ADM=$(id -gn "$AMMINISTRATORE" 2>/dev/null) ||
        fermati "l'utente '$AMMINISTRATORE' in AllowUsers non esiste su questa macchina" \
                "rilancia e rispondi «s» alla domanda su chi può entrare, per sostituirlo"
    DIR_SSH_ADM=$HOME_ADM/.ssh
    AK=$DIR_SSH_ADM/authorized_keys

    if [ -L "$DIR_SSH_ADM" ] || [ -L "$AK" ]; then
        fermati "$DIR_SSH_ADM, o la sua authorized_keys, è un link simbolico" \
                "da root non lo seguo: scriverei dove punta il link, non dove credi. Toglilo e rilancia."
    fi

    PRESENTI=$(grep -c '^[^#[:space:]]' "$AK" 2>/dev/null || true)
    [ -n "$PRESENTI" ] || PRESENTI=0

    VUOLE=si
    if [ -z "$CHIAVE_ADMIN" ]; then
        if ! interattivo; then
            VUOLE=no
            if [ "$PRESENTI" -gt 0 ]; then
                invariato "chiave dell'amministratore: $AK ne contiene già $PRESENTI"
            else
                resta "$AK è vuota: dopo il ricarico di sshd '$AMMINISTRATORE' non
      entrerà più. Rilanciare con --chiave-admin, prima del ricarico."
            fi
        elif [ "$PRESENTI" -gt 0 ]; then
            printf '\n%s contiene già %s chiavi:\n' "$AK" "$PRESENTI"
            awk '!/^#/ && $1 ~ /^(ssh-|ecdsa-|sk-)/ {
                     c = ""; for (i = 3; i <= NF; i++) c = c (i > 3 ? " " : "") $i
                     print "    " (c == "" ? "(senza commento)" : c)
                 }' "$AK" 2>/dev/null || true
            printf '  aggiungerne una? [s/N] '
            read -r risposta || risposta=n
            case $risposta in
                s|S|si|Si|SI|y|Y) ;;
                *) VUOLE=no; invariato "chiave dell'amministratore: lasciate come erano" ;;
            esac
        fi
    fi

    if [ "$VUOLE" = si ]; then
        if [ -z "$CHIAVE_ADMIN" ] && interattivo; then
            printf '\nLA TUA CHIAVE PUBBLICA, per entrare quando le password saranno spente.\n'
            printf 'Generata sulla POSTAZIONE al passo 4. Incolla la riga intera del\n'
            printf 'file .pub, oppure indica il percorso del file.\n'
            printf 'Riconoscila dal commento: le due chiavi hanno la stessa forma.\n'
            printf '    ssh-ed25519 AAAA…  %s…        <- questa, la TUA\n' "$COMMENTO_ADMIN"
            printf '    ssh-ed25519 AAAA…  %s…  <- quella del servizio, NON qui\n' "$COMMENTO_SERVIZIO"
            suggerimento 'type "$env:USERPROFILE\.ssh\id_ed25519_${VM}_admin.pub"' \
                         'da eseguire SULLA POSTAZIONE, nella finestra del passo 4'
        fi
        chiedi CHIAVE_ADMIN "  la tua chiave pubblica:" valida_chiave_admin --chiave-admin
        printf '  riconosciuta: %s  %s\n' \
               "$(commento_di "$CHIAVE_ADMIN")" "$(impronta "$CHIAVE_ADMIN")"

        if grep -qF "$(blob_di "$CHIAVE_ADMIN")" "$AK" 2>/dev/null; then
            invariato "chiave dell'amministratore: già presente in $AK"
        else
            if [ "$PROVA" = no ]; then
                install -d -m 700 -o "$AMMINISTRATORE" -g "$GRUPPO_ADM" "$DIR_SSH_ADM"
            fi
            tmp=$(mktemp)
            cat "$AK" 2>/dev/null > "$tmp" || true
            printf '%s\n' "$CHIAVE_ADMIN" >> "$tmp"
            installa "$tmp" "$AK" 600 \
                     "chiave dell'amministratore: aggiunta a $AK" \
                     "$AMMINISTRATORE" "$GRUPPO_ADM"
        fi
    fi
fi

# --- 3. La chiave del servizio -------------------------------------------- #

ATTUALE=""
if [ -s "$CHIAVE_SERVIZIO" ]; then
    ATTUALE=$(grep -v '^#' "$CHIAVE_SERVIZIO" | head -1 | cut -d' ' -f4-)
    [ -n "$ATTUALE" ] || ATTUALE="una chiave senza commento"
fi

if da_compilare "La chiave del canale di servizio" "$ATTUALE"; then
    if [ -z "$CHIAVE" ] && interattivo; then
        printf '\nLA CHIAVE PUBBLICA DEL CANALE DI SERVIZIO.\n'
        printf 'È con questa che Hermes, dal tuo PC, parlerà con questo server.\n'
        printf 'Generata sulla POSTAZIONE al passo 4. Incolla la riga intera del\n'
        printf 'file .pub, oppure indica il percorso del file.\n'
        printf 'Riconoscila dal commento: le due chiavi hanno la stessa forma.\n'
        printf '    ssh-ed25519 AAAA…  %s…  <- questa, del servizio\n' "$COMMENTO_SERVIZIO"
        printf '    ssh-ed25519 AAAA…  %s…        <- la tua, NON qui\n' "$COMMENTO_ADMIN"
        suggerimento 'type "$env:USERPROFILE\.ssh\id_ed25519_hermes_$VM.pub"' \
                     'da eseguire SULLA POSTAZIONE, nella finestra del passo 4'
    fi
    chiedi CHIAVE "  chiave pubblica del servizio:" valida_chiave_servizio --chiave

    # Commento e impronta sono l'unico modo di riconoscere la chiave dopo:
    # mostrarli evita di installare quella sbagliata fra due identiche a
    # occhio. L'impronta si confronta con `ssh-keygen -l -f` sulla postazione.
    printf '  riconosciuta: %s  %s\n' "$(commento_di "$CHIAVE")" "$(impronta "$CHIAVE")"

    if [ "$PROVA" = no ]; then
        install -d -m 755 -o root -g root "$DIR_CHIAVI"
    fi
    tmp=$(mktemp)
    cat > "$tmp" <<EOF
# Chiave del canale di servizio, installata da bin/hermes-configura.
# Le restrizioni stanno qui E nel drop-in di sshd: qui sono la seconda rete.
command="$REPO/bin/hermes-core-server",no-port-forwarding,no-agent-forwarding,no-X11-forwarding,no-pty $CHIAVE
EOF
    installa "$tmp" "$CHIAVE_SERVIZIO" 644 \
             "chiave del servizio: $CHIAVE_SERVIZIO"
fi

# --- 3. Il perimetro dei bersagli ----------------------------------------- #

if [ ! -f "$SCOPE" ]; then
    fermati "manca $SCOPE" "lo genera il bootstrap: sudo bin/hermes-bootstrap"
fi

ATTUALE=""
if ! grep -q "$NON_COMPILATO" "$SCOPE"; then
    # Le sole reti: le righe `"…",` di un elenco su più righe possono essere
    # anche prefissi di percorso, e mostrarli come reti direbbe all'operatore
    # un perimetro che non è il suo.
    ATTUALE=$(sed -n '/^reti *= *\[/,/^\]/s/^ *"\(.*\)",$/\1/p' "$SCOPE" | tr '\n' ' ')
    [ -n "$ATTUALE" ] || ATTUALE="un perimetro senza reti"
fi

if da_compilare "Il perimetro dei bersagli" "$ATTUALE"; then
    if [ -z "$RETI" ] && interattivo; then
        printf '\nQUALI MACCHINE I TOOL POTRANNO ANALIZZARE.\n'
        printf 'Si dichiarano per rete, non una per una. Tutto ciò che sta fuori\n'
        printf 'viene rifiutato, anche se qualcuno lo chiede esplicitamente.\n'
        printf 'Esempio: 192.0.2.0/24 vale tutti gli indirizzi da 192.0.2.0 a 192.0.2.255.\n'
        printf 'Più reti: separate da virgola.\n'
        suggerimento "ip -o route show scope link | awk '{print \$1}'" \
                     'le reti a cui questa macchina è attaccata: di solito una sola serve'
    fi
    chiedi RETI "  reti:" valida_reti --reti

    if [ -z "$ALIAS" ] && interattivo; then
        printf '\nNOMI BREVI PER I BERSAGLI CHE USERAI SPESSO.\n'
        printf "Servono a scrivere 'lab-web' nei comandi invece di ricordarti\n"
        printf "l'indirizzo. Non c'è nessuna risoluzione DNS: la corrispondenza\n"
        printf 'fra nome e indirizzo la decidi qui, e non cambia sotto i piedi.\n'
        printf 'Esempio: lab-web=192.0.2.20,lab-db=192.0.2.21\n'
        printf 'Invio per non definirne nessuno.\n'
        suggerimento 'ip neigh' \
                     'le macchine che questa VM ha già visto parlare: non è un inventario'
        printf '  alias: '
        read -r ALIAS || ALIAS=""
    fi
    if [ -n "$ALIAS" ]; then
        chiedi ALIAS "  alias:" valida_alias --alias
    fi

    # I prefissi di percorso non li chiede questo script: si aggiungono a
    # mano, servono solo a chi registra tool che puntano a un file. Ma
    # riscrivendo il file li perderebbe in silenzio, e un tool di tipo
    # percorso scoprirebbe al primo uso un perimetro che nessuno ha deciso di
    # restringere. Si conservano come sono.
    PERCORSI_ESISTENTI=$("$PY" -I -S - "$SCOPE" <<'PYEOF' 2>/dev/null || true
import sys
import tomllib
try:
    with open(sys.argv[1], "rb") as fh:
        voci = tomllib.load(fh).get("percorsi", [])
except (OSError, tomllib.TOMLDecodeError):
    voci = []
for voce in voci if isinstance(voci, list) else []:
    if isinstance(voce, str):
        print(voce)
PYEOF
    )

    tmp=$(mktemp)
    {
        printf '# Perimetro dei bersagli ammessi (A2).\n'
        printf '# Compilato da bin/hermes-configura. Di root, fuori da state_dir:\n'
        printf '# un tool che potesse riscrivere la propria allowlist non ne avrebbe una.\n\n'
        printf 'reti = [\n'
        # Il \n finale non è cosmetico: senza, `read` incontra la fine del
        # flusso sull'ultimo valore, esce diverso da zero, e il corpo del
        # ciclo non viene eseguito nemmeno una volta. Con una rete sola si
        # ottiene un perimetro vuoto, e l'unica cosa che se ne accorge è il
        # caricatore - che infatti se n'è accorto.
        printf '%s\n' "$RETI" | tr ',' '\n' | while read -r rete; do
            [ -n "$rete" ] && printf '    "%s",\n' "$rete"
        done
        printf ']\n\n'
        if [ -n "$PERCORSI_ESISTENTI" ]; then
            printf '# Prefissi di percorso: conservati dal perimetro precedente.\n'
            printf 'percorsi = [\n'
            printf '%s\n' "$PERCORSI_ESISTENTI" | while read -r prefisso; do
                [ -n "$prefisso" ] && printf '    "%s",\n' "$prefisso"
            done
            printf ']\n\n'
        fi
        printf '# Nessuna risoluzione DNS, per scelta: una tabella dichiarata non\n'
        printf '# cambia sotto i piedi fra il controllo e l'\''uso.\n'
        printf '[alias]\n'
        if [ -n "$ALIAS" ]; then
            printf '%s\n' "$ALIAS" | tr ',' '\n' | while read -r voce; do
                [ -n "$voce" ] || continue
                printf '%s = "%s"\n' \
                       "$(printf '%s' "$voce" | cut -d= -f1)" \
                       "$(printf '%s' "$voce" | cut -d= -f2)"
            done
        fi
    } > "$tmp"

    # Il validatore vero. Se il caricatore del progetto non lo accetta, non
    # si installa: meglio un giro in più adesso che un server che non parte
    # con un messaggio da interpretare.
    if ! esito=$(cd "$REPO" && "$PY" - "$tmp" <<'PYEOF' 2>&1
import sys
from pathlib import Path
from mcp_server.scope import ScopeAllowlist, ScopeError
try:
    perimetro = ScopeAllowlist.carica(Path(sys.argv[1]))
except ScopeError as err:
    print(err); sys.exit(1)
print(perimetro)
PYEOF
    ); then
        rm -f "$tmp"
        fermati "il perimetro generato non è caricabile: $esito" \
                "è un difetto di questo script: segnalarlo invece di correggere a mano"
    fi
    installa "$tmp" "$SCOPE" 644 "perimetro: reti $RETI${ALIAS:+ · alias $ALIAS}"
fi

# --- 4. La regola di ufw -------------------------------------------------- #

ATTUALE=""
if command -v ufw >/dev/null 2>&1 &&
   ufw status 2>/dev/null | grep -q 'SSH postazione Hermes'; then
    ATTUALE=$(ufw status 2>/dev/null | sed -n 's/.*ALLOW IN *\([0-9.]*\) *# SSH postazione Hermes/\1/p' | head -1)
    [ -n "$ATTUALE" ] || ATTUALE="una regola già presente"
fi

if ! da_compilare "La regola ufw per la postazione" "$ATTUALE"; then
    POSTAZIONE=""
elif [ -z "$POSTAZIONE" ] && interattivo; then
    printf "\nL'INDIRIZZO DEL PC DA CUI TI COLLEGHI.\n"
    printf 'Serve a restringere la porta 22 a quel solo indirizzo, invece di\n'
    printf 'lasciarla aperta a tutta la rete.\n'
    printf 'Non indovinarlo: lo stampa questo server stesso.\n'
    printf 'Invio per saltare.\n'
    suggerimento 'echo "$SSH_CONNECTION" | cut -d" " -f1' \
                 "l'indirizzo da cui arriva la sessione aperta adesso"
    printf '  postazione: '
    read -r POSTAZIONE || POSTAZIONE=""
fi

if [ -z "$POSTAZIONE" ]; then
    saltato "regola ufw: nessuna postazione indicata"
    promemoria "la 22 va ristretta alla sola postazione (docs §4.3)"
else
    chiedi POSTAZIONE "  postazione:" valida_ip --postazione
    if [ "$PROVA" = si ]; then
        mostra "regola ufw: allow from $POSTAZIONE to any port 22 proto tcp"
    elif ! command -v ufw >/dev/null 2>&1; then
        saltato "regola ufw: ufw non è installato"
    else
        ufw allow from "$POSTAZIONE" to any port 22 proto tcp \
            comment 'SSH postazione Hermes' >/dev/null
        fatto "regola ufw: 22 aperta da $POSTAZIONE"
        # Le regole aperte NON si toccano qui: cancellare l'accesso SSH è
        # nella stessa classe del ricarico di sshd. Se l'indirizzo è
        # sbagliato, il sintomo arriva alla prossima connessione.
        if ufw status 2>/dev/null | grep -q '22.*Anywhere'; then
            resta "togliere le regole aperte della 22, dopo aver verificato che
      la regola ristretta funzioni. I numeri cambiano a ogni cancellazione,
      quindi si parte dal più alto:
      sudo ufw status numbered"
        fi
    fi
fi

# --- 5. L'indirizzo fisso (scritto, non applicato) ------------------------ #

if [ -z "$INTERFACCIA" ] && [ -z "$INDIRIZZO" ] && interattivo; then
    printf "\nL'INDIRIZZO FISSO DI QUESTA VM.\n"
    printf 'Da qui in avanti questo indirizzo viene registrato altrove — nella\n'
    printf 'configurazione ssh della postazione, e poi in Hermes — quindi va\n'
    printf 'fissato adesso: se cambia dopo, quelle registrazioni puntano a\n'
    printf 'una macchina che non risponde.\n'
    printf 'Il file viene scritto ma NON applicato: applicarlo cambia indirizzo\n'
    printf 'e fa cadere questa sessione, quindi va fatto dalla console.\n'
    printf 'Invio per restare in DHCP, sapendo che cambierà.\n'
    suggerimento 'ip -br a' \
                 "l'interfaccia da cui ti raggiunge la postazione, non quella che porta internet"
    printf '  interfaccia: '
    read -r INTERFACCIA || INTERFACCIA=""
fi

if [ -z "$INTERFACCIA" ] && [ -z "$INDIRIZZO" ]; then
    saltato "indirizzo fisso: nessuna interfaccia indicata"
    promemoria "l'indirizzo fisso serve quando l'indirizzo finisce nella
      configurazione di Hermes (docs §8). Fino a lì il DHCP va bene."
else
    chiedi INTERFACCIA "  interfaccia:" valida_interfaccia --interfaccia
    if [ -z "$INDIRIZZO" ] && interattivo; then
        printf "\nL'indirizzo da assegnare a %s, con la lunghezza del prefisso.\n" "$INTERFACCIA"
        printf 'Deve stare FUORI dal pool del DHCP, altrimenti il server lo darà\n'
        printf "prima o poi anche a un'altra macchina, e due host con lo stesso\n"
        printf 'indirizzo si diagnosticano male e settimane dopo.\n'
        suggerimento 'ip -br a' \
                     'la rete attuale: di solito i numeri bassi sono sotto il pool'
    fi
    chiedi INDIRIZZO "  indirizzo (CIDR):" valida_cidr --indirizzo
    tmp=$(mktemp)
    {
        printf 'network:\n  version: 2\n  renderer: networkd\n  ethernets:\n'
        printf '    %s:\n      dhcp4: false\n      addresses:\n' "$INTERFACCIA"
        printf '        - %s\n' "$INDIRIZZO"
        if [ -n "$GATEWAY" ]; then
            printf '      routes:\n        - to: default\n          via: %s\n' "$GATEWAY"
        fi
    } > "$tmp"
    installa "$tmp" "$NETPLAN" 600 "indirizzo fisso: $INDIRIZZO su $INTERFACCIA (scritto, NON applicato)"
    resta "applicare la rete DALLA CONSOLE della VM, non da SSH: cambiando
      indirizzo la sessione cade, non puoi confermare, e netplan annulla
      tutto dopo 120 secondi senza dirti perché.
      sudo netplan try"
fi

# --- Cio' che resta ------------------------------------------------------- #

NOME_VM=$(uname -n)
promemoria "il ricarico di sshd. Questo script non lo fa di proposito: va
      fatto DOPO aver verificato la tua chiave da una finestra nuova, con il
      blocco Host qui sotto già scritto sulla postazione:
      ssh -o PreferredAuthentications=publickey -o PasswordAuthentication=no $NOME_VM
      e solo se entra:
      sudo sshd -t && sudo systemctl reload ssh"
promemoria "il preflight, come utente di servizio, che è il criterio di
      accettazione:
      sudo -u $UTENTE_SERVIZIO .venv/bin/python -m mcp_server.doctor config/hermes.toml"

printf '\n========================================================================\n'
if [ "$PROVA" = si ]; then
    printf 'Prova: tutto validato, niente scritto.\n'
elif [ "$CAMBIATO" = no ]; then
    printf 'Niente da compilare: era già tutto a posto.\n'
else
    printf 'Compilazione completata.\n'
fi
if [ -n "$RESTA" ]; then
    printf '\nVERIFICATO ORA, E MANCA:\n%s' "$RESTA"
fi
printf '\nQUESTO SCRIPT NON LI FA — di proposito:\n%s' "$PROMEMORIA"

# Il blocco Host del passo 7, già compilato.
#
# Era l'ultimo punto della procedura con dei segnaposti da riempire a mano, e
# il peggiore: nome, indirizzo e utente sono tre valori che questa macchina
# conosce e la persona deve ricordare - e l'indirizzo, in particolare, cambia
# a metà procedura, dal DHCP all'indirizzo fisso. Lo scrive chi sa i valori.
FISSO=""
if [ -n "$INDIRIZZO" ]; then
    FISSO=${INDIRIZZO%/*}
elif [ -f "$NETPLAN" ]; then
    FISSO=$(sed -n 's|^ *- *\([0-9.]*\)/[0-9]*$|\1|p' "$NETPLAN" 2>/dev/null | head -1)
fi
printf '\nPER IL PASSO 7 — sulla POSTAZIONE, in PowerShell:\n\n'
printf '%s\n' 'Add-Content -Path "$env:USERPROFILE\.ssh\config" -Value @'"'"
printf '\n'
printf 'Host %s\n' "$NOME_VM"
printf '    HostName %s\n' "${FISSO:-INDIRIZZO-DELLA-VM}"
printf '    User %s\n' "${AMMINISTRATORE:-UTENTE}"
printf '    IdentityFile ~/.ssh/id_ed25519_%s_admin\n' "$NOME_VM"
printf '    IdentitiesOnly yes\n'
printf '%s\n' "'"'@'
if [ -z "$FISSO" ]; then
    printf '\nNessun indirizzo fisso configurato: al posto di INDIRIZZO-DELLA-VM\n'
    printf 'metti quello attuale, sapendo che il DHCP può cambiarlo.\n'
fi
printf '========================================================================\n'
